# Neon Postgres connection string (never commit the real value)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# -- Guardian AI assistant -------------------------------------------------
# Sign-in uses a Privy app for Guardian Hub authentication. Configure the
# Privy app for this site and add this site's domain under Allowed domains.
# Preserve existing values/credentials in shared environments.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Email/password sign-up and login (Google can be configured later).
GUARDIAN_PASSWORD_AUTH=true
# Signs session cookies; use 32+ characters in deployments. Local `next dev`
# uses a temporary session key when this is blank.
GUARDIAN_SESSION_SECRET=
# Public site URL used in password reset links.
GUARDIAN_APP_URL=http://localhost:3000
# Password reset email delivery via Resend (no extra package needed).
# Use a verified sender domain in production. Without these, local `next dev`
# shows the reset link on screen instead of sending an email.
RESEND_API_KEY=
GUARDIAN_FROM_EMAIL=
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=high
XAI_BASE_URL=
AI_TIMEOUT_MS=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Comma-separated emails that become Guardian Admins on sign-in.
GUARDIAN_ADMIN_EMAILS=
# true = verified provider sign-ins become active Viewers; false = an Admin approves.
# Password registrations stay pending in deployments; local dev enables Viewer access.
GUARDIAN_AUTO_VIEWER=false
# Optional prompt allowance (defaults: 3, total, admins included).
# GUARDIAN_PROMPT_LIMIT=3
# GUARDIAN_PROMPT_PERIOD=total
# GUARDIAN_PROMPT_ADMIN_EXEMPT=false

# Team inbox for the contact, commitment and pledge forms (12+ characters).
INBOX_PASSWORD=
